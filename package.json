{
  "name": "fablelab-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "local": "tsx scripts/start-local.ts",
    "start": "tsx server/index.ts",
