# Safe local flow demo. No model calls are made with these settings.
# npm scripts do not load .env automatically; see docs/QUICKSTART.md.
NODE_ENV=development
STUDIO_HOST=127.0.0.1
STUDIO_PORT=4318
STUDIO_DATA_DIR=./data
STUDIO_SYNTHETIC=1
STUDIO_ENABLE_AI=0

# Production requires separately generated values. Do not use 1025.
# NODE_ENV=production
# STUDIO_SYNTHETIC=0
# STUDIO_COOKIE_SECRET=<independently-generated-random-secret-at-least-32-characters>
# STUDIO_ACCESS_CODE_HASH=<sha256-of-your-own-random-invitation-code>
# STUDIO_PUBLIC_ORIGIN=https://fablelab.example

# Optional real ECNU service, configured on the server only.
# STUDIO_ENABLE_AI=1
# ECNU_API_KEY=<your-own-authorized-service-key>
# ECNU_TEXT_MODEL=ecnu-max
# ECNU_TEXT_REASONING=off
# ECNU_TEXT_TIMEOUT_MS=240000
