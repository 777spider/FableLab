# Public release allowlist. Review additions before publishing.
/*
!/.gitignore
!/.gitattributes
!/.env.example
!/LICENSE
!/README.md
!/README.zh-CN.md
!/SOURCES.md
!/CONTRIBUTING.md
!/SECURITY.md
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
!/index.html
!/src/
!/server/
!/shared/
!/scripts/
!/tests/
!/public/
!/docs/
!/.github/

# Credentials and local configuration, anywhere in the checkout.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*credentials*.json

# Runtime accounts, sessions, generated content, and local evidence.
**/node_modules/
**/dist/
**/data/
**/data-demo/
**/private/
**/local/
**/deploy/
**/output/
**/.playwright-cli/
**/playwright-report/
**/test-results/
**/coverage/
**/traces/
**/docs/deployment/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.log
*.jsonl
*.zip
*.tar
*.gz
*.bak
*.backup
*.diff
*.tsbuildinfo
.cookie-secret
.service-lock
.deployment-hold
.DS_Store
Thumbs.db

# The public artwork release contains WebP display copies only.
/public/**/*.png

# Keep only the portable launcher and executable server tests.
/scripts/*
!/scripts/start-local.ts
/tests/*
!/tests/server/
/tests/server/*
!/tests/server/*.test.ts
